<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/ims_qtiasiv1p2 http://www.imsglobal.org/xsd/ims_qtiasiv1p2p1.xsd">
  <assessment ident="BIT320_Week1" title="Week 1: Bash Fundamentals - Log Analysis">
    <section ident="Section1">
      <item ident="Q1" title="Q1"><presentation><flow><material><mattext texttype="text/plain">In bash, what does the pipe operator (|) do when used between two commands?</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Sends the output of the first command as input to the second command</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Runs both commands at the same time in parallel</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Redirects errors to a separate file</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Creates a backup of the original output</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response1">a</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q2" title="Q2"><presentation><flow><material><mattext texttype="text/plain">Which command is used to search for lines matching a specific pattern in a file?</mattext></material><response_lid ident="response2" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">awk</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">grep</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">cut</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">sort</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response2">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q3" title="Q3"><presentation><flow><material><mattext texttype="text/plain">To extract all ERROR lines from a log file and count them, which command sequence is most efficient?</mattext></material><response_lid ident="response3" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">grep ERROR logfile.log | wc -l</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">cat logfile.log | sort | grep ERROR</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">find logfile.log -type f | grep ERROR</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">tail -n 100 logfile.log</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response3">a</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q4" title="Q4"><presentation><flow><material><mattext texttype="text/plain">What does the cut command do when used with the -d and -f options: cut -d',' -f2?</mattext></material><response_lid ident="response4" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Extracts field 2 using comma as the delimiter</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Sorts data by the second column</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Removes all commas from the file</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Counts occurrences of the comma character</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response4">a</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q5" title="Q5"><presentation><flow><material><mattext texttype="text/plain">A log file entry reads: "2026-09-11 14:32:45 ERROR Database connection failed". How would you extract just the timestamp using bash string manipulation?</mattext></material><response_lid ident="response5" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Use cut to split on spaces and extract the first two fields</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Use grep to find the date pattern</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Use awk with a field separator</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">All of the above approaches would work</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response5">d</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q6" title="Q6"><presentation><flow><material><mattext texttype="text/plain">When analyzing a large log file with bash, processing data through pipes in real-time is more memory-efficient than loading the entire file into memory. True or False?</mattext></material><response_lid ident="response6" rcardinality="Single"><render_choice><response_label ident="true"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="false"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response6">true</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q7" title="Q7"><presentation><flow><material><mattext texttype="text/plain">What is the primary purpose of the sort and uniq commands when used together (sort | uniq)?</mattext></material><response_lid ident="response7" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">To remove duplicate entries and organize remaining entries in order</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">To encrypt sensitive log data</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">To merge multiple log files</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">To create a backup of the log file</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response7">a</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q8" title="Q8"><presentation><flow><material><mattext texttype="text/plain">In bash, what does the command: grep -c "ERROR" logfile.log accomplish?</mattext></material><response_lid ident="response8" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Displays all lines containing ERROR with line numbers</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Counts the number of lines containing ERROR</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Removes all ERROR lines from the file</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Creates a copy of the file with only ERROR lines</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response8">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q9" title="Q9"><presentation><flow><material><mattext texttype="text/plain">For analyzing structured log data (like CSV format), which bash tool is best for extracting specific columns and grouping by values?</mattext></material><response_lid ident="response9" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">sed</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">awk</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">grep</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">cut</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response9">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q10" title="Q10"><presentation><flow><material><mattext texttype="text/plain">When learning bash for log analysis, understanding command composition through pipes is more important than memorizing individual command options. True or False?</mattext></material><response_lid ident="response10" rcardinality="Single"><render_choice><response_label ident="true"><material><mattext texttype="text/plain">True</mattext></material></response_label><response_label ident="false"><material><mattext texttype="text/plain">False</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response10">true</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
    </section>
  </assessment>
