  <assessment ident="BIT320_Week5" title="Week 5: Event Log Analysis &amp; System Monitoring">
    <section ident="Section1">
      <item ident="Q1"><presentation><flow><material><mattext texttype="text/plain">Primary difference: real-time monitoring vs log analysis?</mattext></material><response_lid ident="response1" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Real-time catches problems before logs record them</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Logs provide historical data; monitoring tracks current state</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">They are identical</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Logs are only for archival</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response1">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q2"><presentation><flow><material><mattext texttype="text/plain">For performance baseline, what time period is sufficient?</mattext></material><response_lid ident="response2" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">One hour</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">24 hours during normal operations</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">One week for weekly patterns</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Baselines not necessary</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response2">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q3"><presentation><flow><material><mattext texttype="text/plain">Sharp spike in error events typically indicates?</mattext></material><response_lid ident="response3" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">System working normally</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Incident, configuration change, or resource exhaustion</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Logs misconfigured</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Nothing specific</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response3">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q4"><presentation><flow><material><mattext texttype="text/plain">Error rate vs system stability: relationship?</mattext></material><response_lid ident="response4" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">High error rate = always failure</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">No relationship</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Error rate compared to baseline shows stability change</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Errors unmeasurable</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response4">c</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q5"><presentation><flow><material><mattext texttype="text/plain">For capacity planning, most useful metric?</mattext></material><response_lid ident="response5" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Current CPU usage only</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Historical trends showing resource growth over time</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Maximum ever seen</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Average only</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response5">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q6"><presentation><flow><material><mattext texttype="text/plain">Resource approaching limit: what first?</mattext></material><response_lid ident="response6" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Immediately panic</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Compare to baseline and establish alert thresholds</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Shut down services</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Ignore it</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response6">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q7"><presentation><flow><material><mattext texttype="text/plain">Key challenge in multi-server log analysis?</mattext></material><response_lid ident="response7" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Logs are too simple</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Correlating events across sources to find root cause</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Logs contain no useful data</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Single-server is easier but multi-server impossible</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response7">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
      <item ident="Q8"><presentation><flow><material><mattext texttype="text/plain">Comprehensive logging helps accomplish what?</mattext></material><response_lid ident="response8" rcardinality="Single"><render_choice><response_label ident="a"><material><mattext texttype="text/plain">Nothing - logging is just display</mattext></material></response_label><response_label ident="b"><material><mattext texttype="text/plain">Troubleshooting, understanding behavior, auditing, capacity planning</mattext></material></response_label><response_label ident="c"><material><mattext texttype="text/plain">Running scripts faster</mattext></material></response_label><response_label ident="d"><material><mattext texttype="text/plain">Preventing all errors</mattext></material></response_label></render_choice></response_lid></flow></presentation><resprocessing><outcomes><decvar maxvalue="1" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes><respcondition continue="No"><conditionvar><varequal respid="response8">b</varequal></conditionvar><setvar action="Set" varname="SCORE">1</setvar></respcondition></resprocessing></item>
